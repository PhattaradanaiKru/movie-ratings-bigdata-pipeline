# Optional. Spark uses the downloaded data under ./data/raw by default.
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=16
# Identify this project to Wikimedia when fetching public data.
EXTERNAL_SOURCE_USER_AGENT=MovieRatingsFinalProject/1.0 (https://github.com/PhattaradanaiKru/movie-ratings-bigdata-pipeline)
