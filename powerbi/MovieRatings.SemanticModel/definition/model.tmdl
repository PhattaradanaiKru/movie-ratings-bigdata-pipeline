model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PgServer", "PgDatabase", "powerbi_overview", "powerbi_release_year", "powerbi_genres", "powerbi_movies", "powerbi_box_office", "powerbi_wikidata_movies", "powerbi_wikidata_countries", "powerbi_oscars_movies"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table powerbi_overview
ref table powerbi_release_year
ref table powerbi_genres
ref table powerbi_movies
ref table powerbi_box_office
ref table powerbi_wikidata_movies
ref table powerbi_wikidata_countries
ref table powerbi_oscars_movies

ref cultureInfo en-US

