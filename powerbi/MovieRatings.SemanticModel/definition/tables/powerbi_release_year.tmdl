table powerbi_release_year
	lineageTag: 5bce60b7-a2b2-4a42-91a1-45b44847d0d7

	measure 'จำนวนคะแนน MovieLens' = SUM(powerbi_release_year[movielens_rating_count])
		formatString: #,0
		lineageTag: da19ef34-8b66-44df-8b55-1a647e0dcee5

	measure 'MovieLens เฉลี่ย x2 (สเกล 10)' = IF(SUM(powerbi_release_year[movielens_rating_count]) >= 1000, 2 * DIVIDE(SUMX(powerbi_release_year, powerbi_release_year[movielens_rating_count] * powerbi_release_year[movielens_average_rating]), SUM(powerbi_release_year[movielens_rating_count])))
		formatString: 0.00
		lineageTag: 9d840b01-585e-4ab4-9d65-d9bb2d2a51ac

	measure 'IMDb เฉลี่ย (สเกล 10)' = IF(SUM(powerbi_release_year[imdb_vote_count]) >= 1000, DIVIDE(SUMX(powerbi_release_year, powerbi_release_year[imdb_vote_count] * powerbi_release_year[imdb_weighted_average_rating]), SUM(powerbi_release_year[imdb_vote_count])))
		formatString: 0.00
		lineageTag: eec054a6-0aed-42cf-8a33-fc3a3427d1c5

	column release_year
		dataType: int64
		formatString: 0
		lineageTag: 4851f2e8-0249-4fad-86b1-36fe58a77400
		summarizeBy: none
		sourceColumn: release_year

	column rated_movie_count
