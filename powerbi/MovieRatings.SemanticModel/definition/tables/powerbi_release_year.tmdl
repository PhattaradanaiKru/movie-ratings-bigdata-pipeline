		summarizeBy: none
		sourceColumn: rated_movie_count

	column movielens_rating_count
		dataType: int64
		formatString: #,0
		lineageTag: 33e9a9a8-5256-4bf8-b171-3be8c103794e
		summarizeBy: none
		sourceColumn: movielens_rating_count

	column movielens_average_rating
		dataType: double
		formatString: 0.00
		lineageTag: e427bf0d-efbf-48a0-8164-955c387f7ee3
		summarizeBy: none
		sourceColumn: movielens_average_rating

	column imdb_movie_count
		dataType: int64
		formatString: #,0
		lineageTag: b6d43719-5df5-411f-99c3-e9bba29a05c8
		summarizeBy: none
		sourceColumn: imdb_movie_count

	column imdb_vote_count
		dataType: int64
		formatString: #,0
		lineageTag: ef51e0f8-afb9-412a-95d9-ced9ec8819ff
		summarizeBy: none
		sourceColumn: imdb_vote_count

	column imdb_weighted_average_rating
		dataType: double
		formatString: 0.00
		lineageTag: e9eb440c-5eca-434b-a06e-3a47676effb1
		summarizeBy: none
		sourceColumn: imdb_weighted_average_rating

	partition powerbi_release_year = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    View = Source{[Schema="public", Item="powerbi_release_year"]}[Data],
				    Selected = Table.SelectColumns(View, {"release_year", "rated_movie_count", "movielens_rating_count", "movielens_average_rating", "imdb_movie_count", "imdb_vote_count", "imdb_weighted_average_rating"}),
				    Result = Selected
				in
				    Result

	annotation PBI_ResultType = Table

