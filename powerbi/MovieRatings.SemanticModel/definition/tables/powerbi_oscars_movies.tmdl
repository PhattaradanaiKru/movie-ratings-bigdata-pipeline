	partition powerbi_oscars_movies = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    View = Source{[Schema="public", Item="powerbi_oscars_movies"]}[Data],
				    Selected = Table.SelectColumns(View, {"ceremony_year", "film_title", "nomination_count", "win_count", "movie_id", "movielens_title", "release_year", "movielens_rating_count", "movielens_average_rating", "imdb_vote_count", "imdb_average_rating", "snapshot_at_utc"}),
				    Result = Table.TransformColumns(Selected, {{"snapshot_at_utc", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime}})
				in
				    Result

	annotation PBI_ResultType = Table

