table powerbi_oscars_movies
	lineageTag: 978046da-1d10-48ac-997a-a63c597cdeb4

	measure 'ชนะ Oscar' = SUM(powerbi_oscars_movies[win_count])
		formatString: #,0
		lineageTag: ff064554-9cbd-489c-9891-7bb12d29aea9

	measure 'เข้าชิง Oscar' = SUM(powerbi_oscars_movies[nomination_count])
		formatString: #,0
		lineageTag: 3c7f1e98-c5ed-44f1-b2e7-60fdec5ab06e

	measure 'IMDb เฉลี่ย (Oscar)' = AVERAGE(powerbi_oscars_movies[imdb_average_rating])
		formatString: 0.00
		lineageTag: 2ac2ac11-22c0-453d-bb3d-7f00133ee9e0

	measure 'Oscar snapshot' = MAX(powerbi_oscars_movies[snapshot_at_utc])
		formatString: yyyy-mm-dd
		lineageTag: a606467c-2983-4c9e-a5ba-a4f090a838ab

	measure 'IMDb: ชนะ Oscar' = CALCULATE(AVERAGE(powerbi_oscars_movies[imdb_average_rating]), powerbi_oscars_movies[win_count] > 0, powerbi_oscars_movies[imdb_vote_count] >= 1000)
		formatString: 0.00
		lineageTag: 07e7bf19-c0bb-425d-bc2d-500a5ac252ae

	measure 'IMDb: เข้าชิงแต่ไม่ชนะ' = CALCULATE(AVERAGE(powerbi_oscars_movies[imdb_average_rating]), powerbi_oscars_movies[win_count] = 0, powerbi_oscars_movies[imdb_vote_count] >= 1000)
		formatString: 0.00
		lineageTag: 2c521c0b-9583-4ff0-833a-4630a920e05c

	measure 'IMDb: ไม่เคยเข้าชิง' = VAR nominated = DISTINCT(powerbi_oscars_movies[movie_id]) RETURN AVERAGEX(FILTER(powerbi_movies, powerbi_movies[imdb_vote_count] >= 1000 && powerbi_movies[release_year] >= 1979 && powerbi_movies[release_year] <= 2023 && NOT (powerbi_movies[movie_id] IN nominated)), powerbi_movies[imdb_average_rating])
		formatString: 0.00
		lineageTag: 5b83a93a-3718-41d2-9e37-5711f800ddc8

