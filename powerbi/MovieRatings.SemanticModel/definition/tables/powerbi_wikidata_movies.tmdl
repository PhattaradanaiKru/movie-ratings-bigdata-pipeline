table powerbi_wikidata_movies
	lineageTag: 3505f664-31ba-48a2-8a96-90f03409dadb

	measure 'พบใน Wikidata' = CALCULATE(COUNTROWS(powerbi_wikidata_movies), powerbi_wikidata_movies[wikidata_id] <> "")
		formatString: #,0
		lineageTag: ea6d7208-08a2-4713-9548-e687ce0fb2f0

	measure 'Wikidata snapshot' = MAX(powerbi_wikidata_movies[snapshot_at_utc])
		formatString: yyyy-mm-dd
		lineageTag: 0bc20683-1b8b-4235-926c-f5ca5863f21a

	measure ความครอบคลุม = DIVIDE([พบใน Wikidata], COUNTROWS(powerbi_wikidata_movies))
		formatString: 0.0%
		lineageTag: 31cca44d-f49b-48c4-a961-ea7080ffeda0

	column movie_id
		dataType: int64
		formatString: 0
		lineageTag: 391c9896-8ec4-4322-b79f-281b446b36a7
		summarizeBy: none
		sourceColumn: movie_id

	column title
		dataType: string
		lineageTag: 6fccc8eb-fbb6-4bfa-869a-87d4e9229063
		summarizeBy: none
		sourceColumn: title

	column release_year
		dataType: int64
		formatString: 0
		lineageTag: 0f50dfe4-6e81-440d-a4d1-da6db767edfe
		summarizeBy: none
		sourceColumn: release_year

	column movielens_rating_count
		dataType: int64
		formatString: #,0
		lineageTag: fa2bf7b3-c0f6-4cbe-8560-e3db6d4651f9
		summarizeBy: none
		sourceColumn: movielens_rating_count

	column movielens_average_rating
		dataType: double
		formatString: 0.00
		lineageTag: a655150d-1063-4917-9f56-3648c8e19e7a
		summarizeBy: none
		sourceColumn: movielens_average_rating

	column imdb_vote_count
		dataType: int64
		formatString: #,0
		lineageTag: 7ccb5eb6-5e8b-42f9-985b-89834394519b
		summarizeBy: none
		sourceColumn: imdb_vote_count

	column imdb_average_rating
		dataType: double
		formatString: 0.00
		lineageTag: 54388c45-2f71-45bf-9864-f62781d35468
		summarizeBy: none
		sourceColumn: imdb_average_rating

	column wikidata_id
		dataType: string
		lineageTag: 017f1174-6352-4479-8505-197347ee5667
		summarizeBy: none
		sourceColumn: wikidata_id

	column snapshot_at_utc
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 00a823cd-a40b-46b6-91f3-d1c7c6f39fb5
		summarizeBy: none
		sourceColumn: snapshot_at_utc

	partition powerbi_wikidata_movies = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    View = Source{[Schema="public", Item="powerbi_wikidata_movies"]}[Data],
				    Selected = Table.SelectColumns(View, {"movie_id", "title", "release_year", "movielens_rating_count", "movielens_average_rating", "imdb_vote_count", "imdb_average_rating", "wikidata_id", "snapshot_at_utc"}),
				    Result = Table.TransformColumns(Selected, {{"snapshot_at_utc", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime}})
				in
				    Result

	annotation PBI_ResultType = Table

