table powerbi_box_office
	lineageTag: 7ced7cf8-40cd-4511-a7a9-e63a293155cc

	measure 'รายได้ทั่วโลก (USD)' = SUM(powerbi_box_office[worldwide_gross_usd])
		formatString: $#,0
		lineageTag: 0471b68a-b2f5-4eb6-97d1-0b5bf1be28c6

	measure 'MovieLens เฉลี่ย (รายได้)' = AVERAGE(powerbi_box_office[movielens_average_rating])
		formatString: 0.00
		lineageTag: 6fab3323-be78-4cb1-96ae-4c59da6d5571

	measure 'IMDb เฉลี่ย (รายได้)' = AVERAGE(powerbi_box_office[imdb_average_rating])
		formatString: 0.00
		lineageTag: 6b9433b8-85ad-4193-a117-d1f4cbae3e9c

	measure 'จับคู่ MovieLens ได้' = COUNT(powerbi_box_office[movie_id])
		formatString: #,0
		lineageTag: b41160d7-6a4b-4fea-975e-28ba6e261379

	measure 'Wikipedia snapshot' = MAX(powerbi_box_office[snapshot_at_utc])
		formatString: yyyy-mm-dd
		lineageTag: 34a4d34e-da01-447c-96fa-1f58ca098aa5

	measure 'หนัง Top 50' = COUNTROWS(powerbi_box_office)
		formatString: #,0
		lineageTag: d9e03d00-e86d-4ca0-b946-82ee38e04f89

