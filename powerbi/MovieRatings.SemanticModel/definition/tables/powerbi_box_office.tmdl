	partition powerbi_box_office = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    View = Source{[Schema="public", Item="powerbi_box_office"]}[Data],
				    Selected = Table.SelectColumns(View, {"rank", "web_title", "release_year", "worldwide_gross_usd", "movie_id", "movielens_title", "movielens_rating_count", "movielens_average_rating", "imdb_vote_count", "imdb_average_rating", "snapshot_at_utc"}),
				    Result = Table.TransformColumns(Selected, {{"snapshot_at_utc", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.From(_))), type datetime}})
				in
				    Result

	annotation PBI_ResultType = Table

